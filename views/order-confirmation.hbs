<div class="row">
  <div class="col-sm-6 col-md-6 col-md-offset-3 col-sm-offset-3">
    <h1>Order Confirmed</h1>
    <p>Order ID: {{order._id}}</p>
    <ul class="list-group">
      {{#each order.items}}
      <li class="list-group-item">{{this.title}} x{{this.qty}} — ${{this.price}}</li>
      {{/each}}
    </ul>
    <h4 class="mt-3">Total: ${{order.totalPrice}}</h4>
    <a href="/" class="btn btn-primary mt-3">Continue Shopping</a>
  </div>
</div>